{
  "name": "smart-campus-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,blue \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/run-maven.mjs spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "lint": "npm run lint:frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:backend",
    "test:backend": "node scripts/run-maven.mjs test",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/run-maven.mjs -DskipTests package",
    "ci": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
