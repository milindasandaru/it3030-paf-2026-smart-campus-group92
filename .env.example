# Database Configuration
# Local PostgreSQL (development)
DATABASE_URL=jdbc:postgresql://localhost:5432/smart_campus_hub?sslmode=disable
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Remote PostgreSQL (production - uncomment and update for Supabase)
# DATABASE_URL=jdbc:postgresql://db.<supabase-project>.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-supabase-password

# Server Configuration
SERVER_PORT=8090

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# OAuth2 Configuration (Google - optional)
GOOGLE_CLIENT_ID=placeholder-client-id
GOOGLE_CLIENT_SECRET=placeholder-client-secret

# Frontend API Base URL (for Vite)
VITE_API_BASE_URL=http://localhost:8090/api

# Test Credentials (for local development)
# Username/Email: admin@smartcampus.edu | Password: admin123
# Username/Email: staff@smartcampus.edu | Password: staff123
# Username/Email: student@smartcampus.edu | Password: student123
